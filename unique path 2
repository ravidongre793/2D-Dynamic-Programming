class Solution {
public:
// Recursion & Memo
// TC O(N^2)
// SC O(N^2)
    int m,n;
    int t[101][101];
    int solve(int i,int j,vector<vector<int>>& obstacleGrid){
        if(i == m-1 && j == n-1){
            return 1;
        }
        if(i < 0 || j < 0 || i >= m || j >= n || obstacleGrid[i][j] == 1){
            return 0;
        }
        if(t[i][j] != -1){
            return t[i][j];
        }
        int right = solve(i,j+1,obstacleGrid);
        int down  = solve(i+1,j,obstacleGrid);
        return t[i][j] = right + down;
    }
    int uniquePathsWithObstacles(vector<vector<int>>& obstacleGrid) {
        m = obstacleGrid.size();
        n = obstacleGrid[0].size();
        memset(t,-1,sizeof(t));
        return solve(0,0,obstacleGrid);
    }
};


// Bottom up
class Solution {
public:
    int uniquePathsWithObstacles(vector<vector<int>>& obstacleGrid) {
        int m = obstacleGrid.size();
        int n = obstacleGrid[0].size();
        vector<vector<int>> t(m+1,vector<int>(n+1));
        if (obstacleGrid[0][0] == 1) return 0;
        t[0][0] = 1;
        for(int i=1;i<n;i++){
            if(obstacleGrid[0][i] == 1){
                t[0][i] = 0;
            }
            else if(t[0][i-1] == 0) t[0][i] = 0;
            else t[0][i] = 1;
        }
        for(int i=1;i<m;i++){
            if(obstacleGrid[i][0] == 1){
                t[i][0] = 0;
            }
            else if(t[i-1][0] == 0) t[i][0] = 0;
            else t[i][0] = 1;
        }
        for(int i=1;i<m;i++){
            for(int j=1;j<n;j++){
                if(obstacleGrid[i][j] == 1){
                    t[i][j] = 0;
                }else{
                    t[i][j] = t[i][j-1] + t[i-1][j];
                }
            }
        }
        return t[m-1][n-1];
    }
};

